# ============================================================================
# MAX-бот «IT-служба колледжа» — пример конфигурации
# Скопируйте файл в .env и заполните значения:  cp .env.example .env
# ============================================================================

# --- MAX Bot API (панель разработчика MAX, dev.max.ru/docs) ---
# Токен бота, выданный в панели MAX
MAX_BOT_TOKEN=xxxxxxxxxx
# Базовый URL REST-API MAX
MAX_API_URL=https://maxapi.ru/v3
# Путь локального эндпоинта для приема вебхуков
MAX_WEBHOOK_PATH=/webhook/max
# Публичный HTTPS URL, который MAX будет дергать (должен совпадать с путем выше)
# Пример: https://bot.your-college.ru/webhook/max
WEBHOOK_URL=https://bot.your-college.ru/webhook/max
# Секретный токен вебхука: MAX передает его в заголовке X-Max-Webhook-Secret
SECRET_TOKEN=change-me-random-string

# --- Core API (вся бизнес-логика: баллы, лимиты, тикеты) ---
CORE_API_URL=http://core-api:8000
CORE_API_KEY=your-core-api-key
CORE_API_TIMEOUT=15.0

# --- Redis (хранение FSM-состояний диалогов) ---
# В docker-compose redis доступен по имени сервиса "redis"
REDIS_URL=redis://redis:6379/0

# --- Webhook-сервер (aiohttp) ---
HOST=0.0.0.0
PORT=8080

# --- Прочее ---
# development | production
ENVIRONMENT=production
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
